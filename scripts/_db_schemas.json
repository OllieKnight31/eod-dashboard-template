{
 "stages": {
  "id": "",
  "emoji": "📊",
  "title": "Funnel Health — Conversion vs Target",
  "description": "Recomputed every four hours. Edit KPI Target % freely; nothing else in this table is hand-maintained.",
  "properties": {
   "Stage": {
    "title": {}
   },
   "Definition": {
    "rich_text": {}
   },
   "Last computed": {
    "date": {}
   },
   "Conversion %": {
    "number": {
     "format": "number"
    }
   },
   "Entered": {
    "number": {
     "format": "number"
    }
   },
   "#": {
    "number": {
     "format": "number"
    }
   },
   "Avg days to advance": {
    "number": {
     "format": "number"
    }
   },
   "Movement": {
    "select": {
     "options": [
      {
       "name": "🤖 Automatic",
       "color": "green"
      },
      {
       "name": "✍️ Manual (EOD)",
       "color": "orange"
      }
     ]
    }
   },
   "Open now": {
    "number": {
     "format": "number"
    }
   },
   "Variance": {
    "formula": {
     "expression": "if(prop(\"#\") == 9 or not(prop(\"Entered\") > 0), toNumber(\"\"), round((prop(\"Conversion %\") - prop(\"KPI Target %\")) * 10) / 10)"
    }
   },
   "KPI Target %": {
    "number": {
     "format": "number"
    }
   },
   "Advanced": {
    "number": {
     "format": "number"
    }
   },
   "Owner": {
    "select": {
     "options": [
      {
       "name": "Setter",
       "color": "blue"
      },
      {
       "name": "Closer",
       "color": "orange"
      },
      {
       "name": "Marketing",
       "color": "purple"
      },
      {
       "name": "Delivery",
       "color": "green"
      },
      {
       "name": "Automated",
       "color": "gray"
      }
     ]
    }
   },
   "Health": {
    "formula": {
     "expression": "if(prop(\"#\") == 9, \"◆ End of journey\", if(prop(\"Entered\") > 0, if(prop(\"Conversion %\") >= prop(\"KPI Target %\"), \"🟢 On target\", if(prop(\"Conversion %\") >= prop(\"KPI Target %\") - 10, \"🟡 Watch\", \"🔴 Bottleneck\")), \"· no data yet\"))"
    }
   },
   "How it advances": {
    "rich_text": {}
   },
   "Lost here": {
    "number": {
     "format": "number"
    }
   }
  }
 },
