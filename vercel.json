{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/v/:slug",
      "destination": "/api?action=watch&slug=:slug"
    },
    {
      "source": "/journey",
      "destination": "/api?action=dashboard"
    },
    {
      "source": "/reports",
      "destination": "/api?action=reports"
    },
    {
      "source": "/eod",
      "destination": "/eod-report.html"
    },
    {
      "source": "/scorecard",
      "destination": "/scorecard.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ],
  "crons": [
    { "path": "/api?action=reminders", "schedule": "0 8 * * *" },
    { "path": "/api?action=reminders", "schedule": "0 9 * * *" },
    {
      "path": "/api?action=cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api?action=cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api?action=cron",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api?action=cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api?action=cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api?action=cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api?action=cron",
      "schedule": "0 6 * * *"
    },
    {
