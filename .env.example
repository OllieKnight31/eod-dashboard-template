# Copy to .env for local runs, and add the same names in Vercel (Settings, Environment Variables).
# Generate secrets with: openssl rand -hex 24

# Notion internal integration token (notion.so/my-integrations). Share the parent page with the integration.
NOTION_API_KEY=
# Page the setup scripts build everything under (only the setup scripts need it).
NOTION_PARENT_PAGE=
# The Sales (lead CRM) database id. Optional if notion.sales_db is set in journey.config.json.
NOTION_SALES_DB=

# Notion ids written to journey.state.json by the setup scripts. Only needed when you deploy
# without that file (for example from a Git integration that ignores it). Copy them from it.
NOTION_STAGES_DB=
NOTION_EOD_DB=
NOTION_SETTER_DB=
NOTION_ASSETS_DB=
NOTION_SESSIONS_DB=
NOTION_SIGNOFF_DB=

# Optional: the brand name shown on every page (overrides business.name in journey.config.json).
BUSINESS_NAME=

# The https address of this deployment, e.g. https://your-eod-app.example.com (no trailing slash).
PUBLIC_BASE_URL=

# Optional. Leave blank and the site has NO login: anyone with the link can use every page.
# Set it (and redeploy) to turn logins on: this becomes the setup code you type on /login to
# create the owner login. It also encrypts saved settings and logins, so do not change it once
# logins exist (or set SETTINGS_SECRET separately first). ACCESS_PASSWORD works the same way.
ADMIN_PASSWORD=
ACCESS_PASSWORD=
# Optional: a separate encryption secret for settings and logins.
SETTINGS_SECRET=

# Ops key: scripts and the e2e tests pass &key=<this> and act as a manager.
SYNC_SECRET=
# Recommended. Vercel sends this as a Bearer token on every cron call. If blank, the scheduled
# jobs accept Vercel's own cron caller instead, so reminders still run out of the box.
CRON_SECRET=
# Optional: lets an outside form file reports with Authorization: Bearer <this>.
INBOUND_KEY=

# Discord bot token (discord.com/developers, Bot, Reset Token). The bot needs View Channel,
# Send Messages, Embed Links and Read Message History in the EOD channels.
DISCORD_BOT_TOKEN=

# Upstash Redis for saved settings (and logins, if on). Added for you by the Vercel Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: the key the settings are stored under (change it to share one Redis between clients).
SETTINGS_KV_KEY=

# Optional: GoHighLevel private integration token, used to add payment-collection tasks to contacts.
GHL_TOKEN=

# Optional overrides for anything also editable on /settings.
TIMEZONE=
